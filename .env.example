NODE_ENV=development
PORT=3000

# ─── Database (easiest: free Neon — NO install on your PC) ───
# 1. Go to https://neon.tech → sign up free
# 2. Create project → copy the connection string
# 3. Paste it here. Tables auto-create on first start (DB_SYNC=true).
#
# Example:
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auto-create all tables when the app starts (leave true)
DB_SYNC=true
DB_LOGGING=false

# Optional: only if you are NOT using DATABASE_URL (local Postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=ctb

# API auth (optional for local). If set, send header: x-api-key
API_KEY=

# CORS — empty = allow all in dev. Production: set frontend URL(s).
# CORS_ORIGINS=https://your-dashboard.example.com
CORS_ORIGINS=

# Rate limit: requests per IP per minute (default 120)
RATE_LIMIT_PER_MIN=120

# Polymarket / trading
POLYMARKET_API_BASE=https://data-api.polymarket.com
RPC_URL=https://poly.api.pocket.network
PRIVATE_KEY=
FUNDER_ADDRESS=
POLYMARKET_API_CREDS=

MIN_SIGNAL_SIZE=5
MAX_POSITION_SIZE=5
DEFAULT_TICK_SIZE=0.01
DEFAULT_NEG_RISK=false
